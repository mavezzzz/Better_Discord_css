}


/* ======================================================
   9. SELECTION
====================================================== */

::selection {
  background: var(--oled-red-glow);
  color: #fff;
}


/* ======================================================
   10. SCROLLBAR
====================================================== */

::-webkit-scrollbar-thumb {
  background-color: var(--scrollbar-color);
}


/* ======================================================
   11. BUTTONS
====================================================== */

button,
[role="button"] {

  /* Positive buttons */
  --button-positive-background: var(--oled-red);

  /* Danger buttons use Discord default */
}


/* ======================================================
   12. RAINBOW ANIMATION
====================================================== */

@keyframes rainbow {

  0% {
    filter: hue-rotate(0deg);
  }

  100% {
    filter: hue-rotate(360deg);
  }

}

