/* ======================================================
   1. VARIABLES
====================================================== */

:root {
  /* Images */
  --theme-background-image: url("https://i.imgur.com/VYjAucth.jpg");
  --home-icon-image: url("https://i.imgur.com/0FzaR0C.jpeg");
  --home-icon-image-zoom: cover;
  --home-icon-image-position: center;

  /* Transparency */
  --theme-transparency: rgba(0, 0, 0, 0.2);
  --message-box-transparency: rgba(0, 0, 0, 0.18);

  /* Colors */
  --main-theme-color: #ff1f3d;
  --oled-red: #ff3156;
  --oled-red-soft: rgba(255, 49, 86, 0.2);
  --oled-red-glow: rgba(255, 49, 86, 0.38);

  /* Scrollbar */
  --scrollbar-color: rgba(255, 23, 64, 0.5);

  /* Blur */
  --blur-default: blur(5px);
  --blur-heavy: blur(15px);

  /* Unread server animation */
  --unread-server-animation: rainbow;
}


/* ======================================================
   2. MAIN BACKGROUND
====================================================== */

.appMount__51fd7 {
  background-color: #050000;

  background-image:
    linear-gradient(
      rgba(40, 0, 8, 0.2),
      rgba(0, 0, 0, 0.28)
    ),
    var(--theme-background-image);

  background-size: 112%;
  background-position: center;
  background-repeat: no-repeat;
  background-blend-mode: soft-light, normal;

  filter: contrast(1.38) saturate(1.14);
}


