   7. MESSAGE BUBBLES
====================================================== */

/* Message text */

.message__5126c .messageContent_c19a55,
[class^="message_"] [class*="messageContent"],
[class*=" message_"] [class*="messageContent"] {

  color: #ffffff !important;

  width: fit-content;
  max-width: calc(100% - 16px);

  padding: 4px 20px;

  border-radius: 6px;

  background: rgba(0, 0, 0, 0.22) !important;

  line-height: 1.45;

  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}


