/* ======================================================
   1. VARIABLES
====================================================== */

:root {
  --theme-background-image: url("https://i.imgur.com/FJbuRhP.jpeg");

  --home-icon-image: url("https://i.imgur.com/gKobCyA.png");
  --home-icon-image-zoom: cover;
  --home-icon-image-position: center;

  --theme-transparency: rgba(0, 0, 0, 0.2);
  --message-box-transparency: rgba(0, 0, 0, 0.18);

  /* AMOLED Purple Theme */
  --main-theme-color: #9333ea;
  --oled-purple: #b651c3;
  --oled-purple-soft: rgba(192, 38, 211, 0.18);
  --oled-purple-glow: rgba(182, 81, 195, 0.45);

  /* Scrollbar */
  --scrollbar-color: rgba(140, 50, 225, 0.64);
}


/* ======================================================
   2. MAIN BACKGROUND
====================================================== */

.appMount__51fd7 {
